---
import type { ImageMetadata } from 'astro';
import { responsive } from '../lib/images';
import soonCover from '../assets/soon-cover.avif';

interface Props {
  title: string;
  /** No href: a "soon" card without a link */
  href?: string;
  cover?: ImageMetadata;
  size?: 'M' | 'L' | 'XL';
  /** Portfolio filter tag */
  tag?: string;
  /** Cards on the first screen load right away instead of lazily */
  eager?: boolean;
  /** Video cards have a wider title */
  variant?: 'project' | 'video';
}

const { title, href, cover, size = 'M', tag, eager = false, variant = 'project' } = Astro.props;

// Rendered width of a card: four in a row, two for L, the whole row for XL
const SIZES = {
  M: '(max-width: 768px) 50vw, 25vw',
  L: '(max-width: 768px) 100vw, 50vw',
  XL: '100vw',
};
const img = await responsive(cover ?? soonCover);
---

<div class:list={['projects-grid-item', size !== 'M' && size]} data-tag={tag}>
  <a class="project-promo-link" href={href}>
    <div class:list={[variant === 'video' ? 'video-promo' : 'project-promo', 'promo']}>
      <picture>
        <source type="image/avif" srcset={img.avifSrcset} sizes={SIZES[size]} />
        <img
          class="project-promo__cover"
          src={img.fallback}
          width={img.width}
          height={img.height}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
      </picture>
      <h2>{title}</h2>
    </div>
  </a>
</div>
